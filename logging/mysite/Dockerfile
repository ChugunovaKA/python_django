# Используем официальный Python образ
FROM python:3.10-slim

# Объявляем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл с зависимостями в рабочую директорию
COPY requirements.txt .

# Устанавливаем зависимости (сначала)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем остальные файлы проекта (после установки зависимостей для кеширования)
COPY . .

# Указываем команду запуска сервера Django (порт 8000)
CMD ["python", "mysite/manage.py", "runserver", "0.0.0.0:8000"]

# Проброс порта 8000 для хоста
EXPOSE 8000
