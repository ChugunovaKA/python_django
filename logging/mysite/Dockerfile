# Используем официальный Python образ (например, версия 3.10)
FROM python:3.10-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл с зависимостями из корня контекста (logging) в рабочую директорию контейнера
COPY requirements.txt .

# Устанавливаем зависимости (сначала, чтобы использовать кеширование слоёв)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем содержимое папки mysite (ваш Django проект) в рабочую директорию контейнера
COPY mysite/ .

# Открываем порт 8000
EXPOSE 8000

# Команда запуска сервера Django (manage.py лежит в /app, т.е. на уровне WORKDIR)
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]